# Base URL for the detection REST API (placeholder — set once the backend is deployed)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket endpoint for the live detection stream (placeholder — set once the backend is deployed)
VITE_WS_URL=ws://localhost:8000/ws/detection

# Central mock/demo mode switch. "true" (default) uses simulated detection
# data so the app works reliably without a backend — recommended for SIH
# demos. Set to "false" once the real backend above is deployed and
# reachable. Can also be toggled at runtime from the in-app Settings page.
VITE_USE_MOCK_MODE=true
